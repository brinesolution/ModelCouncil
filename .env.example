# Copy values into the root .env file. Never commit real credentials.
MODEL_COUNCIL_ENV=development
MODEL_COUNCIL_LOG_LEVEL=INFO

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
DEEPSEEK_LIVE_ENABLED=false
DEEPSEEK_RENDER_CONCURRENCY=4
DEEPSEEK_FULL_LIVE_CONCURRENCY=4
DEEPSEEK_MAX_LIVE_REQUESTS_PER_RUN=10
DEEPSEEK_CACHE_PRIME_REQUESTS=2
# Cost estimates are configurable because provider pricing can change.
DEEPSEEK_CACHE_HIT_USD_PER_MILLION=0.0028
DEEPSEEK_CACHE_MISS_USD_PER_MILLION=0.14
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.28
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DISCOVERY_TIMEOUT_SECONDS=2
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_FULL_LIVE_CONCURRENCY=1

API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/modelcouncil
